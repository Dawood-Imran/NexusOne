digraph sql_repair_subgraph {
  graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.42", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#64748b", fontname="DejaVu Sans", fontsize=11];
  edge [color="#475569", fontname="DejaVu Sans", fontsize=9];
  n___start__ [label="__start__", shape=oval, fillcolor="#e0f2fe"];
  n_load_user_context [label="load_user_context", shape=box, fillcolor="#f8fafc"];
  n_classify_sql_intent [label="classify_sql_intent", shape=box, fillcolor="#f8fafc"];
  n_select_allowed_sources [label="select_allowed_sources", shape=box, fillcolor="#f8fafc"];
  n_build_schema_context [label="build_schema_context", shape=box, fillcolor="#f8fafc"];
  n_draft_sql [label="draft_sql", shape=box, fillcolor="#f8fafc"];
  n_validate_sql_safety [label="validate_sql_safety", shape=box, fillcolor="#f8fafc"];
  n_record_validation_feedback [label="record_validation_feedback", shape=box, fillcolor="#f8fafc"];
  n_repair_sql [label="repair_sql", shape=box, fillcolor="#f8fafc"];
  n_execute_or_package [label="execute_or_package", shape=box, fillcolor="#f8fafc"];
  n_record_execution_feedback [label="record_execution_feedback", shape=box, fillcolor="#f8fafc"];
  n_check_answer_grounding [label="check_answer_grounding", shape=box, fillcolor="#f8fafc"];
  n_record_answer_feedback [label="record_answer_feedback", shape=box, fillcolor="#f8fafc"];
  n_format_safe_answer [label="format_safe_answer", shape=box, fillcolor="#f8fafc"];
  n_finalize_repair_failure [label="finalize_repair_failure", shape=box, fillcolor="#f8fafc"];
  n___end__ [label="__end__", shape=oval, fillcolor="#dcfce7"];
  n___start__ -> n_load_user_context;
  n_build_schema_context -> n_draft_sql;
  n_check_answer_grounding -> n_format_safe_answer [style="dashed", label="grounded"];
  n_check_answer_grounding -> n_record_answer_feedback [style="dashed", label="answer_feedback"];
  n_classify_sql_intent -> n_select_allowed_sources;
  n_draft_sql -> n_validate_sql_safety;
  n_execute_or_package -> n_check_answer_grounding [style="dashed", label="ok"];
  n_execute_or_package -> n_record_execution_feedback [style="dashed", label="execution_feedback"];
  n_load_user_context -> n_classify_sql_intent;
  n_record_answer_feedback -> n_finalize_repair_failure [style="dashed", label="finalize"];
  n_record_answer_feedback -> n_repair_sql [style="dashed", label="repair"];
  n_record_execution_feedback -> n_finalize_repair_failure [style="dashed", label="finalize"];
  n_record_execution_feedback -> n_repair_sql [style="dashed", label="repair"];
  n_record_validation_feedback -> n_finalize_repair_failure [style="dashed", label="finalize"];
  n_record_validation_feedback -> n_repair_sql [style="dashed", label="repair"];
  n_repair_sql -> n_validate_sql_safety;
  n_select_allowed_sources -> n_build_schema_context [style="dashed", label="allowed"];
  n_select_allowed_sources -> n_finalize_repair_failure [style="dashed", label="refused"];
  n_validate_sql_safety -> n_execute_or_package [style="dashed", label="safe"];
  n_validate_sql_safety -> n_record_validation_feedback [style="dashed", label="validation_feedback"];
  n_finalize_repair_failure -> n___end__;
  n_format_safe_answer -> n___end__;
}