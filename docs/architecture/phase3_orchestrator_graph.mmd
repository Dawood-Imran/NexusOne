flowchart TD
  START([START]) --> LOAD[load_user_context]
  LOAD --> PRECHECK[precheck_guardrails]
  PRECHECK --> ROUTE[route_question]

  ROUTE -- denied/error --> FINAL[finalize_response]
  ROUTE -- CASUAL --> CASUAL[deterministic_casual_response]
  ROUTE -- GENERAL_KNOWLEDGE --> GENERAL[compose_general_knowledge<br/>OpenAI or existing local fallback]
  ROUTE -- sql --> SQL[run_sql_subgraph]
  ROUTE -- rag --> RAG[retrieve_rag_context]
  ROUTE -- combined --> SQL

  CASUAL --> VALIDATE[validate_answer]
  GENERAL --> VALIDATE

  SQL -- sql only --> VALIDATE[validate_answer]
  SQL -- combined --> RAG
  RAG --> VALIDATE
  VALIDATE -- CASUAL or GENERAL_KNOWLEDGE --> FINAL
  VALIDATE -- RAG/SQL/ticket/combined --> COMPOSE[compose_final_answer<br/>OpenAI or existing local fallback]
  COMPOSE --> FINAL
  FINAL --> END([END])

  subgraph SQLSubgraph["Independent SQL subgraph"]
    SQL_LOAD[load_user_context]
    SQL_INTENT[classify_sql_intent]
    SQL_SOURCES[select_allowed_sources]
    SQL_SCHEMA[build_schema_context]
    SQL_DRAFT[draft_sql]
    SQL_VALIDATE[validate_sql_safety]
    SQL_EXEC[execute_or_package]
    SQL_GROUND[check_answer_grounding]
    SQL_REPAIR[repair_sql loop]
    SQL_LOAD --> SQL_INTENT --> SQL_SOURCES --> SQL_SCHEMA --> SQL_DRAFT --> SQL_VALIDATE --> SQL_EXEC --> SQL_GROUND
    SQL_VALIDATE -. unsafe .-> SQL_REPAIR -. retry .-> SQL_VALIDATE
    SQL_EXEC -. execution/grounding issue .-> SQL_REPAIR
  end

  RAG -. uses .-> LSA[Local LSA + lexical hybrid search]
  RAG -. fallback .-> LEXICAL[metadata lexical search]
  PRECHECK -. server-side policy .-> GUARDRAILS[default-deny guardrails]
