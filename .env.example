# scripts/run_web_app.py loads the repository-root .env without overriding shell values.
OPENAI_API_KEY=sk-your-key-here
OPENAI_SQL_MODEL=gpt-4.1-mini
OPENAI_SQL_TEMPERATURE=0
OPENAI_ANSWER_MODEL=gpt-4.1-mini
OPENAI_ANSWER_TEMPERATURE=0
DATABASE_URL=postgresql+psycopg2://nexusone:nexusone_dev_password@localhost:5492/nexusone
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2-your-key-here

# Local-only synthetic authentication. Override the checked-in synthetic
# fallback with a password used only on your development machine.
NEXUSONE_AUTH_PASSWORD=replace-with-a-local-only-password
NEXUSONE_AUTH_COOKIE_SECURE=false
NEXUSONE_AUTH_SESSION_TTL_SECONDS=28800
LANGSMITH_PROJECT=nexusone-copilot
